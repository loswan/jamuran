# =========================================================================
# JAMATH VPS PRODUCTION NGINX REVERSE PROXY CONFIGURATION
# Location: /etc/nginx/sites-available/jamath.conf
# =========================================================================
# Ganti "DOMAIN-SAYA" dengan nama domain VPS Anda (misal: jamath.sekolah.sch.id)

# Redirect HTTP ke HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN-SAYA;

    # Certbot challenge location
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Main HTTPS Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name DOMAIN-SAYA;

    # SSL Certificates (Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/DOMAIN-SAYA/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN-SAYA/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Gzip Compression untuk aset statis game
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # 1. Endpoint Multiplayer WebSocket (WSS: wss://DOMAIN-SAYA/ws)
    location /ws {
        proxy_pass http://127.0.0.1:3000/ws;
        proxy_http_version 1.1;

        # Upgrade Headers untuk WebSocket
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Forwarded Client Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout WebSocket (Cegah Nginx menutup koneksi idle setelah 60 detik)
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 60s;

        # Nonaktifkan buffering untuk respon real-time instan
        proxy_buffering off;
    }

    # 2. REST API & Health Check Endpoint
    location /api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 3. Static Assets Caching & SPA Routing
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Cache control untuk aset statis
        proxy_cache_bypass $http_upgrade;
    }
}
